# Configuration du prototype — copier ce fichier en .env et renseigner la clé.
# Ne jamais publier le fichier .env (il est exclu du dépôt par .gitignore).

# Clé d'API OpenAI : vectorisation (text-embedding-3-small) et rédaction (gpt-3.5-turbo)
OPENAI_API_KEY=sk-your-key-here

# Port du serveur (3001 par défaut)
PORT=3001

# Adresses autorisées à appeler le serveur.
# Prévu pour la bêta : pas encore lu par server-fixed.js (constat n° 5 de la revue de code).
CORS_ORIGIN=http://localhost:3001
